# ─────────────────────────────────────────────────────────────
# ÉLINE PARFUMERIE — Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# ─────────────────────────────────────────────────────────────

# ── Supabase (Required for live database) ──────────────────
# Find these in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production: NEXT_PUBLIC_APP_URL=https://www.eline-parfumerie.dz

# ── EcoTrack / Navex Delivery ─────────────────────────────
ECOTRACK_BASE_URL=https://navexdelivery.ecotrack.dz
ECOTRACK_API_TOKEN=your_ecotrack_api_token_here

# ── WhatsApp Notifications (Green API) ───────────────────────
GREEN_API_URL=https://7107.api.greenapi.com
GREEN_API_ID_INSTANCE=your_id_instance_here
GREEN_API_TOKEN_INSTANCE=your_api_token_instance_here
WHATSAPP_ADMIN_PHONE=213555204591

# ── Optional: Error Monitoring ──────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ── How to set up Supabase ───────────────────────────────────
# 1. Go to https://supabase.com and create a free project
# 2. In the SQL Editor, run each migration file in order:
#    - supabase/migrations/00001_initial_schema.sql
#    - supabase/migrations/00002_rls_and_security.sql
#    - supabase/migrations/00003_functions_and_rpcs.sql
#    - supabase/migrations/00004_seed_data.sql
# 3. Copy your Project URL and Anon Key into this file
# 4. Rename this file to .env.local
# 5. Restart the dev server: npm run dev
